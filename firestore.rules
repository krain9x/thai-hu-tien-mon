rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in [
          'krain9x@tienmon.local',
          'krain9x.tw@gmail.com'
        ]
      );
    }

    // Dữ liệu chung & Bảng xếp hạng
    match /tm_meta/{doc} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /tm_giftcodes/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /tm_giftcode_claims/{doc} {
      allow read: if isSignedIn() && (resource == null || resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /tm_users/{uid} {
      allow read: if true;
      allow create: if isSignedIn() && (request.auth.uid == uid || uid.matches('^bot_.*') || isAdmin())
                    && (!('banned' in request.resource.data) || request.resource.data.banned == false || isAdmin());
      allow update: if isSignedIn() && (
                      isAdmin() ||
                      uid.matches('^bot_.*') ||
                      (request.auth.uid == uid && request.resource.data.get('banned', false) == resource.data.get('banned', false))
                    );
      allow delete: if isAdmin();
    }
    match /tm_saves/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == uid || uid.matches('^bot_.*') || isAdmin());
    }
    match /tm_billing/{uid} {
      allow read, write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }
    match /tm_orders/{doc} {
      allow read: if isSignedIn() && (resource == null || resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    match /tm_guilds/{doc} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /tm_veins/{doc} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /tm_vein_claims/{doc} {
      allow read: if isSignedIn() && (resource == null || resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /tm_market/{doc} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /tm_mails/{doc} {
      allow read: if isSignedIn() && (resource.data.to_user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.to_user_id == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    match /tm_friends/{doc} {
      allow read, write: if isSignedIn();
    }
    match /tm_chat/{doc} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    match /tm_plaza/{uid} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid;
    }
    match /tm_pk_invites/{doc} {
      allow read, write: if isSignedIn();
    }
    match /tm_pk_rooms/{doc} {
      allow read, write: if isSignedIn();
    }
    match /tm_coop_rooms/{doc} {
      allow read, write: if isSignedIn();
    }
    match /tm_pk_logs/{doc} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
