rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Đọc công khai BXH, Quảng Trường, Bang Hội, Linh Mạch, Boss Thế Giới, Chợ, Chat
    match /tm_meta/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /tm_users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == uid || uid.matches('^bot_.*'));
    }
    match /tm_saves/{uid} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == uid || uid.matches('^bot_.*'));
    }
    match /tm_billing/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /tm_orders/{doc} {
      allow read, write: if request.auth != null;
    }
    match /tm_guilds/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /tm_veins/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /tm_vein_claims/{doc} {
      allow read, write: if request.auth != null;
    }
    match /tm_market/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /tm_mails/{doc} {
      allow read, write: if request.auth != null;
    }
    match /tm_friends/{doc} {
      allow read, write: if request.auth != null;
    }
    match /tm_chat/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /tm_plaza/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /tm_pk_invites/{doc} {
      allow read, write: if request.auth != null;
    }
    match /tm_pk_rooms/{doc} {
      allow read, write: if request.auth != null;
    }
    match /tm_coop_rooms/{doc} {
      allow read, write: if request.auth != null;
    }
    match /tm_giftcode_claims/{doc} {
      allow read, write: if request.auth != null;
    }
    match /tm_pk_logs/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
